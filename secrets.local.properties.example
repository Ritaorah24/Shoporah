# Template for local secrets.
# 1. Copy this file and name the copy: secrets.local.properties
# 2. Fill in the real values in the COPY only.
# The copy is git-ignored; this template is committed and must stay without real values.

# Keep "?options=-c%20search_path%3dpublic,public&stringtype=unspecified" at the end of the URL.
DB_URL=jdbc:postgresql://<host>:5432/<database>?options=-c%20search_path%3dpublic,public&stringtype=unspecified
DB_USERNAME=
DB_PASSWORD=

# Database used by ./gradlew test. It is WIPED and rebuilt on every test run, so the
# database name must end in _test (the tests refuse anything else). Same server and options as DB_URL.
TEST_DB_URL=jdbc:postgresql://<host>:5432/<database>_test?options=-c%20search_path%3dpublic,public&stringtype=unspecified

# First super admin, created once by Flyway migration V9 (temporary password,
# must be changed on first login). No single quote (') allowed in these values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# JWT signing key: random, at least 32 bytes, base64-encoded. Anyone with it can forge tokens.
# Generate one with (Git Bash): head -c 32 /dev/urandom | base64
JWT_SECRET=

# Paystack secret key (Paystack dashboard -> Settings -> API Keys & Webhooks). Use the TEST key
# (sk_test_...) outside production. Required: the app refuses to start without it.
PAYSTACK_SECRET_KEY=
# Optional: where Paystack sends the customer after paying (e.g. the frontend's payment-result page).
# Leave blank to use the callback URL set in the Paystack dashboard.
PAYSTACK_CALLBACK_URL=

# Optional: SMTP server for emails (checkpoint 2.1). In development use Mailtrap's Email Sandbox
# (mailtrap.io -> Email Testing -> Sandboxes -> SMTP settings): it catches every email, nothing reaches
# real inboxes. Leave MAIL_HOST blank to run without email (emails are queued, then marked FAILED).
MAIL_HOST=
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
# Sender address shown on emails (any address works with the Mailtrap sandbox).
MAIL_FROM=no-reply@shoporah.test

# Optional: the frontend page that password reset emails link to (the token is added as ?token=...).
# Must not be blank; delete the line to use the default http://localhost:3000/reset-password.
#PASSWORD_RESET_URL=

# Optional: Cloudinary account for product images (checkpoint 2.2). Free account at cloudinary.com, then
# Dashboard -> API Keys: Cloud name, API Key, API Secret. Leave blank to run without image uploads (they answer 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
