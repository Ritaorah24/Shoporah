# Template for local secrets.
# 1. Copy this file and name the copy: secrets.local.properties
# 2. Fill in the real values in the COPY only.
# The copy is git-ignored; this template is committed and must stay without real values.

# Keep "?options=-c%20search_path%3dpublic,public&stringtype=unspecified" at the end of the URL.
DB_URL=jdbc:postgresql://<host>:5432/<database>?options=-c%20search_path%3dpublic,public&stringtype=unspecified
DB_USERNAME=
DB_PASSWORD=

# Database used by ./gradlew test. It is WIPED and rebuilt on every test run, so the
# database name must end in _test (the tests refuse anything else). Same server and options as DB_URL.
TEST_DB_URL=jdbc:postgresql://<host>:5432/<database>_test?options=-c%20search_path%3dpublic,public&stringtype=unspecified

# First super admin, created once by Flyway migration V9 (temporary password,
# must be changed on first login). No single quote (') allowed in these values.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# JWT signing key: random, at least 32 bytes, base64-encoded. Anyone with it can forge tokens.
# Generate one with (Git Bash): head -c 32 /dev/urandom | base64
JWT_SECRET=
